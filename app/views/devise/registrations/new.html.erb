<% content_for :title, "Sign up - Mezzanine" %>

<%= render layout: "devise/shared/auth_card", locals: { title: "Sign up" } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <%= f.label :first_name, "First name" %>
      <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", required: true %>
    </div>

    <div class="auth-field">
      <%= f.label :last_name, "Last name" %>
      <%= f.text_field :last_name, autocomplete: "family-name", required: true %>
    </div>

    <div class="auth-field">
      <%= f.label :email %>
      <%= f.email_field :email, autocomplete: "email", required: true %>
    </div>

    <div class="auth-field">
      <%= f.label :password %>
      <% if @minimum_password_length %>
        <span class="auth-hint">(<%= @minimum_password_length %> characters minimum)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", required: true %>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
    </div>

    <div class="auth-actions">
      <%= f.submit "Sign up", class: "auth-button" %>
    </div>
  <% end %>

  <nav class="auth-links" aria-label="Authentication links">
    <%= render "devise/shared/links" %>
  </nav>
<% end %>
