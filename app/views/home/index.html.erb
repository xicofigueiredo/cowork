<% content_for :title, "Mezzanine" %>

<main class="landing">
  <section class="landing-hero">
    <article class="landing-panel">
      <%= image_tag "landing/left.png", alt: "", class: "landing-panel-image", "aria-hidden": "true" %>
    </article>

    <article class="landing-panel">
      <%= image_tag "landing/home.jpg", alt: "Bright coworking space", class: "landing-panel-image" %>
