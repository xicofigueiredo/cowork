<% content_for :title, "Pricing - Mezzanine" %>

<main class="pricing">

  <section class="pricing-grid">
    <div class="pricing-card pricing-card-daily active" data-category="daily">
      <h2 class="pricing-card-title">Daily</h2>
      <div class="pricing-card-content">
        <%= image_tag "pricing/logo.png", alt: "Mezzanine Daily pass", class: "pricing-card-logo" %>
      </div>
    </div>

    <div class="pricing-card pricing-card-packs" data-category="packs">
      <h2 class="pricing-card-title">Monthly</h2>
      <div class="pricing-card-content">
        <%= image_tag "pricing/logo.png", alt: "Mezzanine Packs", class: "pricing-card-logo" %>
      </div>
    </div>

    <div class="pricing-card pricing-card-virtual" data-category="virtual">
      <h2 class="pricing-card-title">Virtual office</h2>
      <div class="pricing-card-content">
        <%= image_tag "pricing/logo.png", alt: "Mezzanine Virtual Office", class: "pricing-card-logo" %>
      </div>
    </div>

    <div class="pricing-card pricing-card-meeting" data-category="meeting">
      <h2 class="pricing-card-title">Meeting room</h2>
      <div class="pricing-card-content">
        <%= image_tag "pricing/logo.png", alt: "Mezzanine Meeting Room", class: "pricing-card-logo" %>
      </div>
    </div>
  </section>

  <section class="pricing-details">
    <div class="pricing-details-content">
      <h3 class="pricing-details-title">Daily pass</h3>

      <div class="pricing-plans-grid">
        <div class="pricing-plan">
          <h4 class="pricing-plan-title">Daily pass</h4>
          <div class="pricing-plan-prices">
            <span class="pricing-plan-original-price">15,00 €</span>
            <p class="pricing-plan-price">13,00 €</p>
          </div>
          <ul class="pricing-plan-features">
            <li>Hotdesk (choose your seat)</li>
            <li>High speed internet</li>
            <li>Free access to the phone booth</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="pricing-image">
    <%= image_tag "pricing/pricing-computer.jpg", alt: "Workspace with laptop and notebook", class: "pricing-image-photo" %>
  </section>

</main>

<script>
function initializePricing() {
  const pricingCards = document.querySelectorAll('.pricing-card');
  const detailsTitle = document.querySelector('.pricing-details-title');
  const plansGrid = document.querySelector('.pricing-plans-grid');

  const pricingData = {
    daily: {
      title: 'Daily pass',
      plans: [
        {
          title: 'Daily pass',
          originalPrice: '15,00 €',
          price: '13,00 €',
          features: [
            'Hotdesk (choose your seat)',
            'High speed internet',
            'Free access to the phone booth'
          ]
        }
      ]
    },
    packs: {
      title: 'Packs & Monthly',
      plans: [
        {
          title: '5-day pack',
          originalPrice: '60,00 €',
          price: '55,00 €',
          features: [
            '8% discount',
            'Same as daily pass',
            'Prior booking needed',
            'Valid for 3 months'
          ]
        },
        {
          title: '10-day pack',
          originalPrice: '100,00 €',
          price: '100,00 €',
          features: [
            'Same as 5-day pack'
          ]
        },
        {
          title: 'Monthly',
          originalPrice: '150,00 €',
          price: '140,00 €',
          features: [
            'Dedicated desk',
            '5h access to the meeting room',
            'Free access to the phone booth',
            'High speed internet',
            'No minimum commitment'
          ]
        }
      ]
    },
    virtual: {
      title: 'Virtual office (Coming soon)',
      plans: [
        { title: 'Office address + email notification', price: '20,00 €' },
        { title: '+20 pages scan', price: '35,00 €' },
        { title: '+4 hours in the meeting room', price: '50,00 €' }
      ]
    },
    meeting: {
      title: 'Meeting room',
      plans: [
        {
          title: 'Hourly booking',
          price: '15,00 €',
          features: [
            'Private room',
            'Booking 24h in advance',
            'Up to 10 persons',
            'Mounted TV'
          ]
        },
        {
          title: 'Daily booking',
          price: '65,00 €',
          features: [
            'Same as hourly booking'
          ]
        },
        {
          title: 'Hour pack',
          price: 'Contact us'
        }
      ]
    }
  };

  function renderPlan(plan) {
    const showOriginalPrice = plan.originalPrice && plan.originalPrice !== plan.price;
    const featuresHtml = plan.features?.length
      ? `<ul class="pricing-plan-features">${plan.features.map(feature => `<li>${feature}</li>`).join('')}</ul>`
      : '';

    return `
      <h4 class="pricing-plan-title">${plan.title}</h4>
      <div class="pricing-plan-prices">
        ${showOriginalPrice ? `<span class="pricing-plan-original-price">${plan.originalPrice}</span>` : ''}
        <p class="pricing-plan-price">${plan.price}</p>
      </div>
      ${featuresHtml}
    `;
  }

  function updateContent(category) {
    const data = pricingData[category];
    detailsTitle.textContent = data.title;

    plansGrid.innerHTML = '';
    data.plans.forEach(plan => {
      const planElement = document.createElement('div');
      planElement.className = 'pricing-plan';
      planElement.innerHTML = renderPlan(plan);
      plansGrid.appendChild(planElement);
    });
  }

  function updateCardState(activeCard) {
    pricingCards.forEach(card => {
      card.classList.remove('active');
      if (card === activeCard) {
        card.classList.add('active');
      }
    });
  }

  function scrollToDetails() {
    const detailsSection = document.querySelector('.pricing-details');
    if (!detailsSection) return;

    const nav = document.querySelector('.landing-top--shared');
    const navHeight = nav ? nav.offsetHeight : 0;
    const offset = navHeight + 16;
    const top = detailsSection.getBoundingClientRect().top + window.scrollY - offset;

    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
  }

  function handleCardClick(event) {
    const card = event.target.closest('.pricing-card');
    if (!card || !card.dataset.category) return;

    updateCardState(card);
    updateContent(card.dataset.category);
    scrollToDetails();
  }

  document.removeEventListener('click', window.__pricingCardClick);
  window.__pricingCardClick = handleCardClick;
  document.addEventListener('click', handleCardClick);
}

document.addEventListener('turbo:load', initializePricing);
document.addEventListener('DOMContentLoaded', initializePricing);
</script>