<% content_for :title, "Payment - Mezzanine" %>

<main class="booking-page">
  <div class="booking-container booking-container--narrow">
    <h1 class="booking-title">Payment</h1>
    <p class="booking-lead">Review your order before completing payment.</p>

    <div class="booking-summary-card">
      <p class="booking-summary-row">
        <span>Plan</span>
        <strong><%= @order.plan_label %></strong>
      </p>

      <% if @order.plan_type == "daily" && @order.desk_count.positive? %>
        <p class="booking-summary-row">
          <span><%= @order.desk_count > 1 ? "Desks" : "Desk" %></span>
          <strong><%= @order.desk_labels %></strong>
        </p>
      <% elsif @order.seat %>
        <p class="booking-summary-row">
          <span><%= @order.seat.meeting_room? ? "Room" : "Desk" %></span>
          <strong><%= @order.seat.label %></strong>
        </p>
      <% end %>

      <% if @order.booking_date && !@order.monthly_desk_plan? && !@order.virtual_plan? %>
        <p class="booking-summary-row">
          <span>Date</span>
          <strong><%= @order.booking_date.strftime("%-d %B %Y") %></strong>
        </p>
      <% end %>

      <% if @order.starts_at %>
        <p class="booking-summary-row">
          <span>Time</span>
          <strong><%= @order.starts_at.strftime("%-d %B %Y, %H:%M") %> – <%= @order.meeting_ends_at.strftime("%H:%M") %></strong>
        </p>
        <% if @order.plan_type == "meeting_hourly" %>
          <p class="booking-summary-row">
            <span>Duration</span>
            <strong><%= @order.meeting_hours %> <%= "hour".pluralize(@order.meeting_hours) %></strong>
          </p>
          <% if @order.meeting_hours > Order::MEETING_HOURLY_DISCOUNT_THRESHOLD %>
            <p class="booking-summary-row">
              <span>Discount</span>
              <strong>20% off</strong>
            </p>
          <% end %>
        <% end %>
      <% end %>

      <% if @order.monthly_desk_plan? %>
        <p class="booking-summary-row">
          <span>Period</span>
          <strong><%= @monthly_period[:starts_on].strftime("%-d %b %Y") %> – <%= @monthly_period[:ends_on].strftime("%-d %b %Y") %></strong>
        </p>
        <p class="booking-summary-row">
          <span>Meeting room</span>
          <strong><%= Order.plan_config(@order.plan_type)[:meeting_hours] %> hours included</strong>
        </p>
      <% end %>

      <% if @order.credit_pack? %>
        <p class="booking-summary-row">
          <span>Credits</span>
          <strong><%= @order.credit_count %> days</strong>
        </p>
      <% end %>

      <% if @order.virtual_plan? %>
        <% virtual_config = Order.plan_config(@order.plan_type) %>
        <p class="booking-summary-row">
          <span>Period</span>
          <strong>12 months</strong>
        </p>
        <p class="booking-summary-row">
          <span>Monthly equivalent</span>
          <strong><%= Order.format_euros(virtual_config[:monthly_amount_cents]) %>/month</strong>
        </p>
        <% if virtual_config[:meeting_hours].present? %>
          <p class="booking-summary-row">
            <span>Meeting room</span>
            <strong>4h per month (<%= virtual_config[:meeting_hours] %>h total)</strong>
          </p>
        <% end %>
        <% if @order.booking_date.present? %>
          <p class="booking-summary-row">
            <span>Start date</span>
            <strong><%= @order.booking_date.strftime("%-d %B %Y") %></strong>
          </p>
        <% end %>
        <% if @order.company_name.present? %>
          <p class="booking-summary-row">
            <span>Company name</span>
            <strong><%= @order.company_name %></strong>
          </p>
        <% end %>
        <% @order.partners.each_with_index do |partner, index| %>
          <p class="booking-summary-row">
            <span><%= @order.partners.size > 1 ? "Partner #{index + 1}" : "Partner" %></span>
            <strong><%= partner["name"] %> · <%= partner["national_id"] %></strong>
          </p>
        <% end %>
        <% if @order.contact_email.present? %>
          <p class="booking-summary-row">
            <span>Email</span>
            <strong><%= @order.contact_email %></strong>
          </p>
        <% end %>
      <% end %>

      <% if @order.vat_number.present? %>
        <p class="booking-summary-row">
          <span>NIF / VAT</span>
          <strong><%= @order.vat_number %></strong>
        </p>
      <% end %>

      <%= render "shared/checkout_total",
            amount_cents: @order.amount_cents,
            plan_type: @order.plan_type,
            original_amount_cents: @order.original_amount_cents,
            promocode: @order.promocode %>
    </div>

    <div class="booking-payment-actions">
      <%= button_to "Pay with Stripe",
            pay_checkout_path(@order),
            method: :post,
            class: "booking-btn booking-btn--primary booking-btn--full",
            data: { turbo: false } %>
    </div>

    <%= link_to "Cancel", pricing_path, class: "booking-link-back" %>
  </div>
</main>
