<% content_for :title, "Checkout - Mezzanine" %>
<% meeting_checkout = Order::MEETING_PLAN_TYPES.include?(@plan_type) %>
<% desk_checkout = @plan_type == "daily" %>
<% promo_credit_checkout = @promocode.present? %>
<% selected_calendar_day = @calendar_days&.find { |day| day[:date].to_date == @booking_date.to_date } if (desk_checkout || meeting_checkout) && @booking_date.present? %>
<% # Floor plan and this flag must agree: use actual desk availability, not only the calendar lookup.
   desk_day_available = if desk_checkout
     @seats.present? && @unavailable_desks.size < @seats.size
   else
     selected_calendar_day&.dig(:available)
   end %>
<% hourly_slots_available = @hour_grid&.any? { |slot| slot[:available] } %>
<% checkout_submit_disabled = !promo_credit_checkout && (
     (desk_checkout && !desk_day_available) ||
     (meeting_checkout && (
       (@plan_type == "meeting_daily" && !selected_calendar_day&.dig(:available)) ||
       (@plan_type == "meeting_hourly" && (!hourly_slots_available || Array(@selected_slots).blank?))
     ))
   ) %>
<% checkout_total_locals = {
     amount_cents: @order.amount_cents,
     plan_type: @order.plan_type,
     original_amount_cents: @order.original_amount_cents,
     promocode: @promocode
   } %>

<main class="booking-page">
  <div class="booking-container">
    <h1 class="booking-title"><%= Order.plan_config(@plan_type)[:label] %></h1>
    <p class="booking-lead"><%= checkout_plan_description(@plan_type) %></p>

    <%= form_with model: @order, url: checkouts_path, class: "booking-form" do |f| %>
      <%= f.hidden_field :plan_type, value: @plan_type %>
      <%= hidden_field_tag :plan, @plan_type %>
      <%= hidden_field_tag :date, @booking_date if @booking_date.present? %>
      <%= hidden_field_tag :slot, params[:slot] if params[:slot].present? %>

      <% if promo_credit_checkout %>
        <div class="booking-summary-card">
          <p class="booking-summary-row">
            <span>Promo code</span>
            <strong><%= @promocode.code %></strong>
          </p>
          <p class="booking-summary-row">
            <span>Credits</span>
            <strong><%= @promocode.credits %> days</strong>
          </p>
          <p class="booking-summary-row">
            <span>Valid for</span>
            <strong>3 months</strong>
          </p>
          <p class="booking-summary-note">After payment, use your credits to book any available desk on the days you choose.</p>
        </div>

        <%= render "shared/checkout_total", **checkout_total_locals %>

      <% elsif @plan_type == "daily" %>
        <%= f.hidden_field :booking_date, value: @booking_date %>

        <%= render "shared/desk_day_picker",
              calendar_days: @calendar_days,
              booking_date: @booking_date,
              unavailable_desks: @unavailable_desks,
              seats: @seats,
              input_name: "order[seat_id]",
              selected_seat_id: @order.seat_id,
              plan_type: @plan_type %>

        <% unless desk_day_available %>
          <p class="booking-note booking-note--error">No desks available on this day. Choose another day above.</p>
        <% end %>

        <%= render "shared/checkout_total", **checkout_total_locals %>

      <% elsif Order::MONTHLY_DESK_PLAN_TYPES.include?(@plan_type) %>
        <% meeting_hours = Order.plan_config(@plan_type)[:meeting_hours] %>
        <div class="booking-field">
          <p class="booking-note">
            Your dedicated desk will be reserved from
            <strong><%= @monthly_period[:starts_on].strftime("%-d %B %Y") %></strong>
            to
            <strong><%= @monthly_period[:ends_on].strftime("%-d %B %Y") %></strong>.
            You'll receive <%= meeting_hours %> <%= "hour".pluralize(meeting_hours) %> of meeting room access for that period.
          </p>
          <span class="booking-label">Select your desk</span>
          <%= render "shared/floor_plan_picker",
                unavailable_desks: @unavailable_desks,
                seat_map: @seats.index_by(&:code).transform_values(&:id),
                input_name: "order[seat_id]",
                selected_seat_id: @order.seat_id %>
        </div>

        <%= render "shared/checkout_total", **checkout_total_locals %>

      <% elsif @plan_type == "meeting_daily" %>
        <%= f.hidden_field :booking_date, value: @booking_date %>

        <div class="booking-field">
          <span class="booking-label">Choose a day</span>
          <%= render "shared/meeting_calendar_days",
                days: @calendar_days,
                selected_date: @booking_date,
                plan_type: @plan_type %>
        </div>

        <div class="booking-field">
          <div class="booking-summary-card">
            <p class="booking-summary-row">
              <span>Date</span>
              <strong><%= @booking_date.strftime("%-d %B %Y") %></strong>
            </p>
            <p class="booking-summary-row">
              <span>Room</span>
              <strong>Meeting room</strong>
            </p>
            <p class="booking-summary-row">
              <span>Duration</span>
              <strong>Full day (8:00 – 20:00)</strong>
            </p>
          </div>

          <%= render "shared/checkout_total", **checkout_total_locals %>
        </div>

        <% unless selected_calendar_day&.dig(:available) %>
          <p class="booking-note booking-note--error">This day is not available. Choose another day above.</p>
        <% end %>

      <% elsif @plan_type == "meeting_hourly" %>
        <div class="booking-field">
          <span class="booking-label">Choose a day</span>
          <%= render "shared/meeting_calendar_days",
                days: @calendar_days,
                selected_date: @booking_date,
                plan_type: @plan_type %>
        </div>

        <div class="booking-field"
             data-meeting-hourly-checkout
             data-rate-cents="<%= Order.meeting_hourly_rate_cents %>"
             data-discount-threshold="<%= Order::MEETING_HOURLY_DISCOUNT_THRESHOLD %>"
             data-discount-rate="<%= Order::MEETING_HOURLY_DISCOUNT_RATE %>">
          <span class="booking-label">Available slots · <%= @booking_date.strftime("%-d %B %Y") %></span>
          <p class="booking-note" data-meeting-hourly-summary>Tap consecutive slots to select. Bookings over 3 hours get 20% off.</p>
          <div class="meeting-slot-grid">
            <% selected_values = Array(@selected_slots).map(&:iso8601) %>
            <% @hour_grid.each do |slot| %>
              <% if slot[:available] %>
                <label class="meeting-slot meeting-slot--available">
                  <input type="checkbox"
                         name="order[starts_at][]"
                         value="<%= slot[:starts_at].iso8601 %>"
                         data-slot-label="<%= slot[:label] %>"
                         data-slot-ms="<%= (slot[:starts_at].to_f * 1000).to_i %>"
                         <%= "checked" if selected_values.include?(slot[:starts_at].iso8601) %>>
                  <span class="meeting-slot-time"><%= slot[:label] %></span>
                  <span class="meeting-slot-range"><%= slot[:label] %> – <%= slot[:ends_at].strftime("%H:%M") %></span>
                </label>
              <% else %>
                <div class="meeting-slot meeting-slot--unavailable" aria-hidden="true">
                  <span class="meeting-slot-time"><%= slot[:label] %></span>
                  <span class="meeting-slot-range">Taken</span>
                </div>
              <% end %>
            <% end %>
          </div>
          <% unless hourly_slots_available %>
            <p class="booking-note">No available slots on this date. Pick another day above.</p>
          <% end %>
        </div>

        <div class="booking-field">
          <div class="booking-summary-card">
            <p class="booking-summary-row">
              <span>Date</span>
              <strong><%= @booking_date.strftime("%-d %B %Y") %></strong>
            </p>
            <p class="booking-summary-row">
              <span>Room</span>
              <strong>Meeting room</strong>
            </p>
            <p class="booking-summary-row">
              <span>Time</span>
              <strong data-meeting-hourly-time>—</strong>
            </p>
            <p class="booking-summary-row">
              <span>Duration</span>
              <strong data-meeting-hourly-duration>Select slots</strong>
            </p>
            <p class="booking-summary-row" data-meeting-hourly-discount-row hidden>
              <span>Discount</span>
              <strong>20% off</strong>
            </p>
          </div>

          <%= render "shared/checkout_total",
                amount_cents: @order.amount_cents,
                plan_type: @order.plan_type,
                original_amount_cents: @order.original_amount_cents,
                promocode: @promocode %>
        </div>

      <% else %>
        <div class="booking-summary-card">
          <p class="booking-summary-row">
            <span>Plan</span>
            <strong><%= Order.plan_config(@plan_type)[:label] %></strong>
          </p>
          <p class="booking-summary-row">
            <span>Credits</span>
            <strong><%= Order.plan_config(@plan_type)[:credits] %> days</strong>
          </p>
          <p class="booking-summary-row">
            <span>Valid for</span>
            <strong>3 months</strong>
          </p>
          <p class="booking-summary-note">After payment, use your credits to book any available desk on the days you choose.</p>
        </div>

        <%= render "shared/checkout_total", **checkout_total_locals %>
      <% end %>

      <div class="booking-inline-fields">
        <div class="booking-field">
          <label class="booking-label" for="promocode">Promo code</label>
          <div class="booking-promocode-row">
            <input type="text"
                   name="promocode"
                   id="promocode"
                   value="<%= @promocode_input.presence || @promocode&.code %>"
                   class="booking-input booking-input--promocode"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Enter code">
            <button type="submit"
                    class="booking-btn booking-btn--secondary booking-btn--promocode"
                    formaction="<%= new_checkout_path %>"
                    formmethod="get"
                    formnovalidate
                    data-turbo="false"
                    name="commit"
                    value="apply_promocode">
              Apply
            </button>
          </div>
          <% if @promocode_error.present? %>
            <p class="booking-note booking-note--error"><%= @promocode_error %></p>
          <% elsif @promocode.present? %>
            <p class="booking-note booking-note--success">
              <%= @promocode.code %> applied — <%= @promocode.credits %> day credits for <%= Order.format_euros(@promocode.amount_cents) %>.
            </p>
          <% else %>
            <p class="booking-note">Optional — enter a code if you have one.</p>
          <% end %>
        </div>

        <div class="booking-field">
          <%= f.label :vat_number, "NIF / VAT number (optional)", class: "booking-label" %>
          <%= f.text_field :vat_number,
                class: "booking-input booking-input--full",
                autocomplete: "off",
                inputmode: "numeric",
                maxlength: 12,
                placeholder: "123456789",
                value: @order.vat_number %>
          <p class="booking-note">Optional — add it if you need NIF on your invoice. Portuguese NIF (9 digits) or PT + NIF.</p>
        </div>
      </div>

      <div class="booking-actions">
        <%= f.submit "Continue to payment",
              class: "booking-btn booking-btn--primary",
              id: "checkout-submit",
              disabled: checkout_submit_disabled %>
        <%= link_to "Back to pricing", pricing_path, class: "booking-btn booking-btn--secondary" %>
      </div>
    <% end %>
  </div>
</main>

<% if @plan_type == "meeting_hourly" %>
<script>
function initializeMeetingHourlyCheckout() {
  const root = document.querySelector("[data-meeting-hourly-checkout]");
  if (!root || root.dataset.ready === "true") return;
  root.dataset.ready = "true";

  const rateCents = parseInt(root.dataset.rateCents, 10);
  const discountThreshold = parseInt(root.dataset.discountThreshold, 10);
  const discountRate = parseFloat(root.dataset.discountRate);
  const summary = root.querySelector("[data-meeting-hourly-summary]");
  const timeEl = document.querySelector("[data-meeting-hourly-time]");
  const durationEl = document.querySelector("[data-meeting-hourly-duration]");
  const discountRow = document.querySelector("[data-meeting-hourly-discount-row]");
  const submitButton = document.getElementById("checkout-submit");
  const slotInputs = Array.from(root.querySelectorAll('input[name="order[starts_at][]"]'));
  const priceRoot = document.querySelector(".booking-price-breakdown");

  function formatEuros(cents) {
    return (cents / 100).toFixed(2).replace(".", ",") + " €";
  }

  function ivaCents(amount) {
    return Math.round(amount * 0.23);
  }

  function selectedSlots() {
    return slotInputs
      .filter((input) => input.checked)
      .sort((a, b) => parseInt(a.dataset.slotMs, 10) - parseInt(b.dataset.slotMs, 10));
  }

  function isConsecutive(slots) {
    if (slots.length <= 1) return true;
    for (let i = 1; i < slots.length; i += 1) {
      if (parseInt(slots[i].dataset.slotMs, 10) - parseInt(slots[i - 1].dataset.slotMs, 10) !== 60 * 60 * 1000) {
        return false;
      }
    }
    return true;
  }

  function updatePrice(hours) {
    if (!priceRoot) return;
    const original = hours * rateCents;
    const amount = hours > discountThreshold ? Math.round(original * (1 - discountRate)) : original;
    const showOriginal = original > amount;
    const values = priceRoot.querySelectorAll(".booking-price-row--subtotal .booking-price-values, .booking-price-row--total .booking-price-values");
    const subtotalStrong = priceRoot.querySelector(".booking-price-row--subtotal strong");
    const ivaStrong = priceRoot.querySelector(".booking-price-row--iva strong");
    const totalStrong = priceRoot.querySelector(".booking-price-row--total strong:last-child");

    values.forEach((container) => {
      container.querySelectorAll(".booking-price-original").forEach((el) => el.remove());
    });

    if (subtotalStrong) {
      if (showOriginal) {
        const originalEl = document.createElement("span");
        originalEl.className = "booking-price-original";
        originalEl.textContent = formatEuros(original);
        subtotalStrong.parentElement.insertBefore(originalEl, subtotalStrong);
      }
      subtotalStrong.textContent = formatEuros(amount);
    }
    if (ivaStrong) ivaStrong.textContent = formatEuros(ivaCents(amount));
    if (totalStrong) {
      if (showOriginal) {
        const originalEl = document.createElement("span");
        originalEl.className = "booking-price-original";
        originalEl.textContent = formatEuros(original + ivaCents(original));
        totalStrong.parentElement.insertBefore(originalEl, totalStrong);
      }
      totalStrong.textContent = formatEuros(amount + ivaCents(amount));
    }
  }

  function updateSelection(changedInput) {
    const selected = selectedSlots();
    if (!isConsecutive(selected) && changedInput) {
      changedInput.checked = false;
      summary.textContent = "Please select consecutive hours.";
      return updateSelection();
    }

    const count = selected.length;
    if (count === 0) {
      summary.textContent = "Tap consecutive slots to select. Bookings over 3 hours get 20% off.";
      if (timeEl) timeEl.textContent = "—";
      if (durationEl) durationEl.textContent = "Select slots";
      if (discountRow) discountRow.hidden = true;
      if (submitButton) submitButton.disabled = true;
      updatePrice(1);
      return;
    }

    const labels = selected.map((input) => input.dataset.slotLabel);
    const startLabel = labels[0];
    const endHour = parseInt(startLabel.split(":")[0], 10) + count;
    const endLabel = `${String(endHour).padStart(2, "0")}:00`;
    summary.textContent = `${count} ${count === 1 ? "hour" : "hours"} selected (${labels.join(", ")}).`;
    if (timeEl) timeEl.textContent = `${startLabel} – ${endLabel}`;
    if (durationEl) durationEl.textContent = `${count} ${count === 1 ? "hour" : "hours"}`;
    if (discountRow) discountRow.hidden = count <= discountThreshold;
    if (submitButton) submitButton.disabled = false;
    updatePrice(count);
  }

  slotInputs.forEach((input) => {
    input.addEventListener("change", () => updateSelection(input));
  });

  updateSelection();
}

document.addEventListener("turbo:before-cache", () => {
  const root = document.querySelector("[data-meeting-hourly-checkout]");
  if (root) delete root.dataset.ready;
});

document.addEventListener("DOMContentLoaded", initializeMeetingHourlyCheckout);
document.addEventListener("turbo:load", initializeMeetingHourlyCheckout);
</script>
<% end %>

