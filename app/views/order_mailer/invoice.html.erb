<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Invoice <%= @invoice_number %></title>
  </head>
  <body style="font-family: Georgia, 'Times New Roman', serif; color: #1a1a1a; max-width: 640px; margin: 40px auto; padding: 0 20px;">
    <header style="margin-bottom: 32px; border-bottom: 2px solid #1a1a1a; padding-bottom: 16px;">
      <h1 style="margin: 0 0 8px; font-size: 28px; font-weight: 400;">Mezzanine</h1>
      <p style="margin: 0; color: #555; font-size: 14px;">
        Rua Brito e Cunha, 27 · Matosinhos<br>
        hello@mezzaninecowork.com
      </p>
    </header>

    <h2 style="margin: 0 0 4px; font-size: 20px; font-weight: 400;">Invoice <%= @invoice_number %></h2>
    <p style="margin: 0 0 24px; color: #555; font-size: 14px;">
      Date: <%= @paid_at.in_time_zone.strftime("%-d %B %Y") %><br>
      Status: Paid
    </p>

    <h3 style="margin: 0 0 8px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; color: #555;">Bill to</h3>
    <p style="margin: 0 0 28px;">
      <%= @order.customer_name %><br>
      <%= @user.email %><br>
      <% if @order.vat_number.present? %>
        NIF / VAT: <%= @order.vat_number %>
      <% end %>
    </p>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 28px;">
      <thead>
        <tr>
          <th style="text-align: left; padding: 10px 0; border-bottom: 1px solid #ccc;">Description</th>
          <th style="text-align: right; padding: 10px 0; border-bottom: 1px solid #ccc;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 12px 0; border-bottom: 1px solid #eee;">
            <%= @order.plan_label %>
            <% if @order.fulfillment_details.any? %>
              <div style="color: #666; font-size: 13px; margin-top: 4px;">
                <% @order.fulfillment_details.each do |label, value| %>
                  <%= label %>: <%= value %><br>
                <% end %>
              </div>
            <% end %>
          </td>
          <td style="padding: 12px 0; border-bottom: 1px solid #eee; text-align: right; vertical-align: top;"><%= @order.amount_euros %></td>
        </tr>
        <tr>
          <td style="padding: 10px 0;">Subtotal</td>
          <td style="padding: 10px 0; text-align: right;"><%= @order.amount_euros %></td>
        </tr>
        <tr>
          <td style="padding: 10px 0;">IVA (23%)</td>
          <td style="padding: 10px 0; text-align: right;"><%= @order.iva_euros %></td>
        </tr>
        <tr>
          <td style="padding: 12px 0; border-top: 2px solid #1a1a1a; font-weight: 700; font-size: 18px;">Total</td>
          <td style="padding: 12px 0; border-top: 2px solid #1a1a1a; text-align: right; font-weight: 700; font-size: 18px;"><%= @order.total_with_iva_euros %></td>
        </tr>
      </tbody>
    </table>

    <p style="color: #666; font-size: 13px;">
      Payment processed securely via Stripe.
      <% if @order.stripe_session_id.present? %>
        Reference: <%= @order.stripe_session_id %>
      <% end %>
    </p>
  </body>
</html>
