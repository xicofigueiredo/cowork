<% if user_signed_in? %>
  <div class="landing-nav-profile-menu" data-controller="dropdown">
    <button
      type="button"
      class="landing-nav-profile"
      data-dropdown-target="toggle"
      data-action="dropdown#toggle"
      aria-label="Account menu"
      aria-haspopup="true"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="9" r="3.5" fill="none" stroke="currentColor" stroke-width="1.75" />
        <path d="M5 20.5c1.6-4 12.4-4 14 0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
    <div class="landing-nav-profile-dropdown" data-dropdown-target="menu" role="menu" hidden>
      <%= link_to "My bookings", bookings_path, class: "landing-nav-profile-dropdown-link", role: "menuitem" %>
      <%= link_to "My account", edit_user_registration_path, class: "landing-nav-profile-dropdown-link", role: "menuitem" %>
      <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "landing-nav-profile-dropdown-link", role: "menuitem" %>
    </div>
  </div>
<% else %>
  <%= link_to new_user_session_path, class: "landing-nav-profile", "aria-label": "Log in" do %>
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="9" r="3.5" fill="none" stroke="currentColor" stroke-width="1.75" />
      <path d="M5 20.5c1.6-4 12.4-4 14 0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    </svg>
  <% end %>
<% end %>
