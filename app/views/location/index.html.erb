<% content_for :title, "Location & Contact — Coworking in Matosinhos, Porto | Mezzanine" %>
<% content_for :meta_description, "Visit Mezzanine coworking and workspace at Rua Brito e Cunha 27, Matosinhos, near Porto. Open weekdays 8:00–20:00. Contact hello@mezzaninecowork.com." %>

<main class="location">

  <section class="location-contact">
    <div class="location-contact-inner">
      <div class="location-contact-intro">
        <h1 class="location-contact-title">Want to know more? Fill in the form and we'll get back to you as soon as we can!</h1>
        <p class="location-contact-subtitle">Follow the next steps</p>
      </div>

      <%= form_with model: @lead, url: location_path, class: "location-contact-form" do |f| %>
        <div class="location-field location-field--first-name">
          <%= f.label :first_name, "First Name*", class: "location-label location-label--first-name", for: "location-first-name" %>
          <%= f.text_field :first_name, id: "location-first-name", class: "location-input location-input--first-name", required: true, autocomplete: "given-name" %>
        </div>

        <div class="location-field location-field--last-name">
          <%= f.label :last_name, "Last Name*", class: "location-label location-label--last-name", for: "location-last-name" %>
          <%= f.text_field :last_name, id: "location-last-name", class: "location-input location-input--last-name", required: true, autocomplete: "family-name" %>
        </div>

        <div class="location-field location-field--email">
          <%= f.label :email, "Email*", class: "location-label location-label--email", for: "location-email" %>
          <%= f.email_field :email, id: "location-email", class: "location-input location-input--email", required: true, autocomplete: "email" %>
        </div>

        <div class="location-field location-field--message">
          <%= f.label :message, "Tell us what you're looking for...", class: "location-label location-label--message", for: "location-message" %>
          <%= f.text_area :message, id: "location-message", class: "location-input location-input--message", rows: 4 %>
        </div>

        <label class="location-privacy">
          <%= f.check_box :privacy_accepted, { class: "location-privacy-checkbox", required: true, id: "location-privacy-accepted" }, "1", "0" %>
          <span>I agree to the <%= link_to "Privacy Policy", privacy_policy_path, class: "location-privacy-link", target: "_blank", rel: "noopener" %>*</span>
        </label>

        <%= f.button "Send", type: :submit, class: "location-submit" %>
      <% end %>
    </div>
  </section>

  <section class="location-info" aria-label="Visit Mezzanine">
    <div class="location-info-inner">
      <h2 class="location-info-title">Visit our coworking space in Matosinhos, near Porto</h2>
      <p class="location-info-copy">
        Mezzanine is a flexible coworking workspace by the sea in Matosinhos — minutes from Porto.
        Drop in for a day of coworking, book a monthly desk, or reserve the meeting room for your team.
      </p>
      <address class="location-info-address">
        <strong>Mezzanine Cowork</strong><br>
        Rua Brito e Cunha 27, R/C<br>
        4450-085 Matosinhos, Porto, Portugal
      </address>
      <p class="location-info-meta">
        <span>Hours: weekdays 08:00–20:00</span>
        <span>·</span>
        <%= mail_to "hello@mezzaninecowork.com", "hello@mezzaninecowork.com", class: "location-info-email" %>
      </p>
    </div>
  </section>

  <section class="location-map">
    <div class="location-map-embed">
      <iframe
        data-requires-consent
        data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6000!2d-8.691271823268368!3d41.18253087132666!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd246f3a12497d49%3A0xdd9697361659ca3c!2sR.%20Brito%20e%20Cunha%2027%2C%204450-081%20Matosinhos!5e0!3m2!1spt-PT!2spt!4v1779300766318!5m2!1spt-PT!2spt"
        title="Mezzanine coworking space in Matosinhos, near Porto"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        hidden></iframe>
    </div>
    <div class="location-map-side" aria-hidden="true"></div>
  </section>

</main>
