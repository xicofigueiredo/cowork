<% content_for :title, "Our Space - Mezzanine" %>

<main class="ourspace">

  <section class="ourspace-hero">
    <%= image_tag "ourspace/ourspace.jpg", alt: "Desks at the main floor", class: "ourspace-hero-photo" %>
    <%= image_tag "landing/logo-mark-pink-trimmed.png", alt: "", class: "ourspace-hero-mark" %>
    <h1 class="ourspace-hero-title">Our Space</h1>
  </section>

  <section class="ourspace-benefits">
    <div class="ourspace-benefits-inner">
      <h2 class="ourspace-benefits-title">Access to multiple benefits</h2>

      <div class="ourspace-benefits-grid">
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>8h-20h access</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 12c0-2.2 1.8-4 4-4s4 1.8 4 4-1.8 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="7" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5 20c.5-3 3.5-5 7-5s6.5 2 7 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Pet friendly</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
          <span>By the sea location</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 6V4h8v2M6 16v2h12v-2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="18" r="1.5" fill="currentColor"/><circle cx="16" cy="18" r="1.5" fill="currentColor"/></svg>
          <span>Public transportation</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v4H8zM6 8h12v12H6z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 12h4M10 16h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Meeting room</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8l-1 14H9L8 4z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 8h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Phone booth</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 21h8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Virtual office (coming soon)</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="16" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 8h6M9 12h6M9 16h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Honest Bar</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 7h6M9 11h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="currentColor"/></svg>
          <span>Pantry</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 20V10l6-4 6 4v10" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 20v-6h4v6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          <span>Lounge area</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="12" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6 14h12v6H6z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 17h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Printer</span>
        </div>
        <div class="ourspace-benefit">
          <svg class="ourspace-benefit-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 7h6M9 11h6M9 15h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="16" cy="15" r="1" fill="currentColor"/></svg>
          <span>Locker (coming soon)</span>
        </div>
      </div>
    </div>
  </section>

  <section class="ourspace-floorplan">
    <div class="ourspace-floorplan-inner">
      <div class="ourspace-floorplan-columns">
        <div class="ourspace-floorplan-column">
          <button type="button" class="ourspace-floorplan-tab active" data-floor="main">Main floor</button>
          <div class="ourspace-floorplan-diagram" data-floor-panel="main">
            <%= raw Rails.root.join("app/assets/images/ourspace/floor-main.svg").read %>
          </div>
        </div>

        <div class="ourspace-floorplan-column">
          <button type="button" class="ourspace-floorplan-tab" data-floor="mezzanine">Mezzanine</button>
          <div class="ourspace-floorplan-diagram" data-floor-panel="mezzanine">
            <%= raw Rails.root.join("app/assets/images/ourspace/floor-mezzanine.svg").read %>
          </div>
        </div>
      </div>

      <div class="ourspace-floorplan-info">
        <p class="ourspace-floorplan-desk" data-ourspace-desk-label>Desk 008</p>
      </div>
    </div>
  </section>

</main>

<script>
function initializeOurSpace() {
  const root = document.querySelector('.ourspace-floorplan');
  if (!root || root.dataset.ourspaceReady === 'true') return;
  root.dataset.ourspaceReady = 'true';

  const tabs = root.querySelectorAll('.ourspace-floorplan-tab');
  const seats = root.querySelectorAll('.ourspace-seat');
  const deskLabel = root.querySelector('[data-ourspace-desk-label]');
  const availabilityLabel = root.querySelector('[data-ourspace-availability]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });

  function updateInfo(seat) {
    if (!seat) return;

    const desk = seat.dataset.desk;
    const floor = seat.dataset.floor === 'mezzanine' ? 'Mezzanine' : 'Main floor';

    deskLabel.textContent = `Desk ${desk}`;
    availabilityLabel.textContent = seat.classList.contains('unavailable') ? 'Unavailable' : 'Available';

    tabs.forEach(tab => {
      tab.classList.toggle('active', tab.dataset.floor === seat.dataset.floor);
    });
  }

  seats.forEach(seat => {
    seat.addEventListener('click', () => {
      if (seat.classList.contains('unavailable')) return;

      seats.forEach(s => s.classList.remove('selected'));
      seat.classList.add('selected');
      updateInfo(seat);
    });
  });

  const initialSeat = root.querySelector('.ourspace-seat.selected') || root.querySelector('.ourspace-seat:not(.unavailable)');
  if (initialSeat) updateInfo(initialSeat);
}

document.addEventListener('turbo:before-cache', () => {
  const root = document.querySelector('.ourspace-floorplan');
  if (root) delete root.dataset.ourspaceReady;
});

document.addEventListener('DOMContentLoaded', initializeOurSpace);
document.addEventListener('turbo:load', initializeOurSpace);
</script>
