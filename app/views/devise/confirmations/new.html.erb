<% content_for :title, "Resend confirmation - Mezzanine" %>

<%= render layout: "devise/shared/auth_card", locals: { title: "Resend confirmation code" } do %>
  <p class="auth-lead">
    Enter your email and we’ll send a new 6-digit confirmation code.
  </p>

  <%= form_for(resource, as: resource_name, url: user_confirmation_path, html: { method: :post, class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email).presence || params[:email] %>
    </div>

    <div class="auth-actions">
      <%= f.submit "Send code", class: "auth-button" %>
    </div>
  <% end %>

  <nav class="auth-links" aria-label="Authentication links">
    <%= render "devise/shared/links" %>
  </nav>
<% end %>
