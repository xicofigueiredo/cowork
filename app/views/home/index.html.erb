<% content_for :title, "Mezzanine" %>

<main class="landing">
  <section class="landing-hero">
    <article class="landing-panel">
      <%= image_tag "landing/left.png", alt: "", class: "landing-panel-image", "aria-hidden": "true" %>
    </article>

    <article class="landing-panel">
      <%= image_tag "landing/home.jpg", alt: "Bright coworking space", class: "landing-panel-image" %>
    </article>

    <article class="landing-panel">
      <%= image_tag "landing/right.png", alt: "", class: "landing-panel-image", "aria-hidden": "true" %>
    </article>
  </section>

  <footer class="landing-footer">
    <%= link_to "Let's talk", "mailto:hello@mezzaninecowork.com" %>
    <%= link_to "https://www.instagram.com/mezzanine.cowork/", target: "_blank", rel: "noreferrer", class: "landing-footer-instagram", "aria-label": "Follow us on Instagram" do %>
      <span>Follow us on</span>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
    <% end %>
  </footer>
</main>
