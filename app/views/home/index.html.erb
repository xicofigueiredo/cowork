<% content_for :title, "Mezzanine — Coworking in Matosinhos" %>
<% content_for :meta_description, "Mezzanine is a bright coworking space in Matosinhos, near Porto. Flexible desks, meeting room, and sea-side workspace access from 8:00–20:00." %>

<main class="landing">
  <h1 class="visually-hidden">Mezzanine — coworking space in Matosinhos</h1>
  <p class="visually-hidden">
    Flexible daily passes, monthly desks, and a meeting room in Matosinhos.
    Visit us at Rua Brito e Cunha 27, open weekdays from 8:00 to 20:00.
  </p>

  <section class="landing-hero" aria-label="Mezzanine workspace">
    <article class="landing-panel landing-panel--left">
      <%= image_tag "landing/left.png", alt: "", class: "landing-panel-image", "aria-hidden": "true" %>
    </article>

    <article class="landing-panel landing-panel--center">
      <%= image_tag "landing/home.jpg", alt: "Bright coworking space at Mezzanine in Matosinhos", class: "landing-panel-image" %>
    </article>

    <article class="landing-panel landing-panel--right">
      <%= image_tag "landing/right.png", alt: "", class: "landing-panel-image", "aria-hidden": "true" %>
    </article>
  </section>

  <footer class="landing-footer">
    <%= link_to "Let's talk", "mailto:hello@mezzaninecowork.com" %>
    <%= link_to "https://www.instagram.com/mezzanine.cowork/", target: "_blank", rel: "noreferrer", class: "landing-footer-instagram", "aria-label": "Follow us on Instagram" do %>
      <span>Follow us on</span>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
    <% end %>
  </footer>
</main>
