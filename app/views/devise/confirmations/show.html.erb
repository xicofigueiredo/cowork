<% content_for :title, "Confirm email - Mezzanine" %>

<%= render layout: "devise/shared/auth_card", locals: { title: "Confirm your email" } do %>
  <p class="auth-lead">
    We sent a 6-digit code to your inbox. Enter it below to activate your account.
  </p>

  <%= form_for(resource, as: resource_name, url: user_confirmation_verify_path, html: { method: :post, class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: resource.email.blank?, autocomplete: "email", required: true, value: resource.email.presence || params[:email] %>
    </div>

    <div class="auth-field">
      <%= f.label :confirmation_token, "Confirmation code" %>
      <%= f.text_field :confirmation_token, autofocus: resource.email.present?, autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9]*", maxlength: 6, required: true, placeholder: "000000", class: "auth-code-input" %>
    </div>

    <div class="auth-actions">
      <%= f.submit "Confirm account", class: "auth-button" %>
    </div>
  <% end %>

  <nav class="auth-links auth-links--stacked" aria-label="Authentication links">
    <%= link_to "Resend confirmation code", new_confirmation_path(resource_name, email: resource.email.presence || params[:email]) %>
    <%= render "devise/shared/links" %>
  </nav>
<% end %>
