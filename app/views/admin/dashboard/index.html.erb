<% content_for :title, "Admin - Mezzanine" %>

<main class="booking-page">
  <div class="booking-container">
    <div class="booking-section-header">
      <h1 class="booking-title">Admin</h1>
    </div>

    <%= render "admin/shared/nav" %>

    <section class="booking-section">
      <div class="admin-floorplan-header">
        <h2 class="booking-section-title">Floor plan</h2>
        <%= form_with url: admin_root_path, method: :get, class: "admin-floorplan-date-form", local: true do %>
          <label for="admin-floorplan-date" class="admin-floorplan-date-label">Date</label>
          <%= date_field_tag :date, @floor_plan_date, id: "admin-floorplan-date", class: "admin-floorplan-date-input", onchange: "this.form.requestSubmit()" %>
        <% end %>
      </div>

      <%= render "admin/dashboard/floor_plan", date: @floor_plan_date, occupancy: @desk_occupancy, desk_count: @desk_count %>
    </section>

    <section class="booking-section">
      <h2 class="booking-section-title">
        Members without door code
        <span class="admin-count"><%= @users_needing_codes.size %></span>
      </h2>

      <% unless @ttlock_configured %>
        <div class="booking-credits-banner">
          <p>TTLock is not configured. Set <code>TTLOCK_*</code> environment variables to issue codes.</p>
        </div>
      <% end %>

      <% if @users_needing_codes.any? %>
        <ul class="booking-list">
          <% @users_needing_codes.each do |user| %>
            <li class="booking-list-item">
              <div>
                <strong><%= user.display_name %></strong>
                <span class="booking-list-meta"><%= mail_to user.email %></span>
              </div>
              <div class="booking-list-actions">
                <% if user.door_code_status == :failed %>
                  <span class="booking-badge booking-badge--failed">Failed</span>
                <% else %>
                  <span class="booking-badge booking-badge--missing">Missing</span>
                <% end %>
                <%= button_to "Issue code",
                      issue_access_code_admin_user_path(user),
                      method: :post,
                      class: "booking-btn booking-btn--primary booking-btn--small",
                      disabled: !@ttlock_configured %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="booking-empty">Every member has a door code on the lock.</p>
      <% end %>
    </section>

    <section class="booking-section">
      <h2 class="booking-section-title">Users <span class="admin-count"><%= @users.size %></span></h2>

      <% if @users.any? %>
        <ul class="booking-list">
          <% @users.each do |user| %>
            <% plan_label = user.current_plan_label %>
            <% day_credits = user.remaining_day_credits %>
            <% meeting_hours = user.remaining_meeting_hours %>
            <% door_code = user.access_code if user.access_code&.synced_to_lock? %>
            <li class="booking-list-item">
              <div class="admin-user-summary">
                <% if plan_label.present? || day_credits.positive? || meeting_hours.positive? %>
                  <div class="admin-user-plan">
                    <% if plan_label.present? %>
                      <span class="booking-badge booking-badge--monthly"><%= plan_label %></span>
                    <% end %>
                    <% if day_credits.positive? %>
                      <span class="admin-user-credits"><%= day_credits %> day <%= "credit".pluralize(day_credits) %></span>
                    <% end %>
                    <% if meeting_hours.positive? %>
                      <span class="admin-user-credits"><%= meeting_hours %> meeting <%= "hour".pluralize(meeting_hours) %></span>
                    <% end %>
                  </div>
                <% end %>
                <strong><%= user.display_name %></strong>
                <span class="booking-list-meta">
                  <%= mail_to user.email %>
                  · Joined <%= user.created_at.strftime("%-d %b %Y, %H:%M") %>
                </span>
                <% if door_code %>
                  <span class="booking-list-meta booking-door-code">
                    Door code: <strong class="booking-door-code-inline"><%= door_code.code %></strong>
                  </span>
                <% end %>
              </div>
              <div class="booking-list-actions">
                <% if door_code %>
                  <span class="booking-badge booking-badge--active">Has code</span>
                  <%= button_to "Delete code",
                        access_code_admin_user_path(user),
                        method: :delete,
                        class: "booking-btn booking-btn--secondary booking-btn--small",
                        data: { turbo_confirm: "Delete door code #{door_code.code} for #{user.email}? It will be removed from the lock." } %>
                <% elsif user.needs_door_code? %>
                  <span class="booking-badge booking-badge--missing">No code</span>
                  <%= button_to "Issue",
                        issue_access_code_admin_user_path(user),
                        method: :post,
                        class: "booking-btn booking-btn--primary booking-btn--small",
                        disabled: !@ttlock_configured %>
                <% end %>
                <% if user.confirmed? %>
                  <span class="booking-badge booking-badge--active">Confirmed</span>
                <% else %>
                  <span class="booking-badge booking-badge--upcoming">Unconfirmed</span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="booking-empty">No user accounts yet.</p>
      <% end %>
    </section>

    <section class="booking-section">
      <h2 class="booking-section-title">Contact forms <span class="admin-count"><%= @leads.size %></span></h2>

      <% if @leads.any? %>
        <ul class="booking-list">
          <% @leads.each do |lead| %>
            <li class="booking-list-item booking-list-item--stacked">
              <div>
                <strong><%= lead.first_name %> <%= lead.last_name %></strong>
                <span class="booking-list-meta">
                  <%= mail_to lead.email %>
                  · <%= lead.created_at.strftime("%-d %b %Y, %H:%M") %>
                </span>
                <% if lead.message.present? %>
                  <p class="admin-lead-message"><%= lead.message %></p>
                <% else %>
                  <span class="booking-list-meta">No message</span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="booking-empty">No contact forms submitted yet.</p>
      <% end %>
    </section>
  </div>
</main>
